rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function profileCreatedByOwner(uid) {
      return signedInAs(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.accountType == 'pharmacy'
        && request.resource.data.isActive == true;
    }

    function protectedProfileFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'uid', 'email', 'licenseNumber', 'accountType',
        'isActive', 'createdAt'
      ]);
    }

    function validMedicine() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 180
        && request.resource.data.batchNo is string
        && request.resource.data.type is string
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 0
        && request.resource.data.costPrice is number
        && request.resource.data.costPrice >= 0
        && request.resource.data.sellingPrice is number
        && request.resource.data.sellingPrice >= 0
        && request.resource.data.expiryDate is timestamp
        && request.resource.data.createdAt is timestamp;
    }

    function validOrder() {
      return request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 200
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount >= 0
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal >= 0
        && request.resource.data.tax is number
        && request.resource.data.tax >= 0
        && request.resource.data.status in [
          'pending', 'processing', 'completed', 'cancelled'
        ]
        && request.resource.data.createdAt is timestamp;
    }

    function validPharmacySettings() {
      return request.resource.data.name is string
        && request.resource.data.currency in ['PKR', 'USD', 'EUR', 'GBP', 'AED']
        && request.resource.data.taxPercent is number
        && request.resource.data.taxPercent >= 0
        && request.resource.data.taxPercent <= 100
        && request.resource.data.lowStockThreshold is int
        && request.resource.data.lowStockThreshold >= 0
        && request.resource.data.expiryWarningDays is int
        && request.resource.data.expiryWarningDays >= 0
        && request.resource.data.alertsEnabled is bool;
    }

    match /users/{uid} {
      allow get: if signedInAs(uid);
      allow create: if profileCreatedByOwner(uid);
      allow update: if signedInAs(uid) && protectedProfileFieldsUnchanged();
      allow list, delete: if false;

      match /medicines/{medicineId} {
        allow read, delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid) && validMedicine();
      }

      match /orders/{orderId} {
        allow read: if signedInAs(uid);
        // Orders are archived rather than permanently deleted to preserve history.
        allow delete: if false;
        allow create, update: if signedInAs(uid) && validOrder();
      }

      match /stockAdjustments/{adjustmentId} {
        allow read: if signedInAs(uid);
        allow create: if signedInAs(uid)
          && request.resource.data.quantityDelta is int
          && request.resource.data.quantityDelta > 0
          && request.resource.data.medicineId is string
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }

      match /settings/{settingsId} {
        allow get: if signedInAs(uid) && settingsId == 'pharmacy';
        allow list, delete: if false;
        allow create: if signedInAs(uid)
          && settingsId == 'pharmacy' && validPharmacySettings();
        allow update: if signedInAs(uid)
          && settingsId == 'pharmacy'
          && validPharmacySettings()
          && request.resource.data.currency == resource.data.currency;
      }
    }

    // Legacy global collections are not a safe multi-account data store.
    match /medicines/{docId} { allow read, write: if false; }
    match /orders/{docId} { allow read, write: if false; }
    match /stockAdjustments/{docId} { allow read, write: if false; }
  }
}
