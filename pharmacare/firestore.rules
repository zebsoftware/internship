rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow get, create, update: if signedInAs(uid);
      allow list, delete: if false;

      match /{subcollection}/{documentId} {
        allow read, write: if signedInAs(uid)
          && subcollection in ['medicines', 'orders', 'stockAdjustments', 'settings'];
      }
    }

    // Existing global collections are not a safe multi-user data store.
    // Legacy records must be backed up and migrated by an administrator.
    match /medicines/{docId} { allow read, write: if false; }
    match /orders/{docId} { allow read, write: if false; }
    match /stockAdjustments/{docId} { allow read, write: if false; }
  }
}
