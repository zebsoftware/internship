rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function profileCreatedByOwner(uid) {
      return signedInAs(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email;
    }

    function protectedProfileFieldsUnchanged() {
      // These fields represent account identity or server-managed state.
      // Self-service settings can still update name and phone fields.
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'uid', 'email', 'licenseNumber', 'accountType',
        'isActive', 'createdAt'
      ]);
    }

    match /users/{uid} {
      allow get: if signedInAs(uid);
      allow create: if profileCreatedByOwner(uid);
      allow update: if signedInAs(uid) && protectedProfileFieldsUnchanged();
      allow list, delete: if false;

      match /{subcollection}/{documentId} {
        allow read, write: if signedInAs(uid)
          && subcollection in ['medicines', 'orders', 'stockAdjustments', 'settings'];
      }
    }

    // Legacy shared collections are intentionally inaccessible.
    // Back up and migrate legacy records via trusted administrator tooling.
    match /medicines/{docId} { allow read, write: if false; }
    match /orders/{docId} { allow read, write: if false; }
    match /stockAdjustments/{docId} { allow read, write: if false; }
  }
}
